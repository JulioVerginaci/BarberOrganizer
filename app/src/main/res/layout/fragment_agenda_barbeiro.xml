<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:id="@+id/conteudoAgendaBarbeiro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">
        <TextView
            android:id="@+id/tituloAgendaBarbeiro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Minha Agenda"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/subtituloAgendaBarbeiro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Selecione um dia para ver os horários marcados."
            android:textColor="@color/text_gray"
            android:textSize="14sp" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fillViewport="false"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/seletorDiasBarbeiro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        <TextView
            android:id="@+id/txtResumoDiaBarbeiro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="ATENDIMENTOS DO DIA"
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/listaAgendamentosBarbeiro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>