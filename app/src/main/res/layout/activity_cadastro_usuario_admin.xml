<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txt_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastrar usuário"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Cadastre clientes, barbeiros ou administradores."
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edt_nome_admin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_campo_login"
            android:hint="Nome completo"
            android:inputType="textPersonName"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray" />

        <EditText
            android:id="@+id/edt_telefone_admin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_campo_login"
            android:hint="Telefone"
            android:inputType="phone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray" />

        <EditText
            android:id="@+id/edt_email_admin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_campo_login"
            android:hint="E-mail"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray" />

        <EditText
            android:id="@+id/edt_senha_admin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_campo_login"
            android:hint="Senha"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perfil do usuário"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_perfil_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_cliente_admin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:padding="8dp"
                android:text="Cliente"
                android:textColor="@color/text_white"
                android:buttonTint="@color/gold_accent" />

            <RadioButton
                android:id="@+id/rb_barbeiro_admin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Barbeiro"
                android:textColor="@color/text_white"
                android:buttonTint="@color/gold_accent" />

            <RadioButton
                android:id="@+id/rb_administrador_admin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Administrador"
                android:textColor="@color/text_white"
                android:buttonTint="@color/gold_accent" />

        </RadioGroup>

        <Button
            android:id="@+id/btn_salvar_usuario_admin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/gold_accent"
            android:text="Cadastrar usuário"
            android:textColor="@color/card_background"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_voltar_admin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/card_background"
            android:text="Voltar ao painel"
            android:textColor="@color/text_white" />

    </LinearLayout>

</ScrollView>
